rules_version = '2';

// Single-owner app. Google Sign-In lets anyone with a Google account
// authenticate, so every rule below re-checks the authenticated email
// against the hardcoded owner address. Update OWNER_EMAIL if you ever
// change which Google account owns this app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'jcaboroca@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /trips/{tripId} {
      allow read, write: if isOwner();

      match /days/{dayId} {
        allow read, write: if isOwner();

        match /stops/{stopId} {
          allow read, write: if isOwner();
        }

        match /journal/{entryId} {
          allow read, write: if isOwner();
        }
      }

      match /packingList/{itemId} {
        allow read, write: if isOwner();
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
