rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'jcaboroca@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Journal photos: /journal/{tripId}/{dayId}/{entryId}/{fileName}
    match /journal/{tripId}/{dayId}/{entryId}/{fileName} {
      allow read, write: if isOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
