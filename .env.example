# Copy this file to .env.local and fill in real values from
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
# .env.local is gitignored — never commit real keys here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your Google account email — the only account Firestore rules allow.
VITE_OWNER_EMAIL=jcaboroca@gmail.com
